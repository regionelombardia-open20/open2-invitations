{
    "name": "open20/amos-invitations",
    "license": "GPL-3.0-or-later",
    "description": "System to invite persons to platform",
    "keywords": ["amos", "yii2", "invitations"],
    "homepage": "http://www.open20.it/",
    "type": "component",
    "require": {
        "php": ">=5.4.0",
        "open20/amos-admin": "^2.3.2",
        "open20/amos-core": "^1.23.0",
        "open20/amos-dashboard": "^1.9.0",
        "open20/amos-notify": "^1.4.24",
        "yii2tech/spreadsheet": "*"
    },
    "config": {
        "process-timeout": 1800,
        "secure-http": false
    },
    "extra": {
        "asset-installer-paths": {
            "npm-asset-library": "vendor/npm",
            "bower-asset-library": "vendor/bower"
        }
    },
    "autoload": {
        "psr-4": {
            "open20\\amos\\invitations\\": "src"
        }
    },
    "require-dev": {
        "yiisoft/yii2-faker": "*"
    }
}